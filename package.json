{
  "name": "forge",
  "private": true,
  "description": "Humanforce Forge integration for AI agent harnesses.",
  "bin": {
    "forge": "console/bin.js"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.4.0",
      "typescript": "^5.9.3",
      "zod": "^4.4.3"
    }
  },
  "type": "module",
  "scripts": {
    "forge": "tsx console/bin.js",
    "prepare": "lefthook install && skills-npm --agents universal --yes",
    "test": "vitest run",
    "format": "oxfmt --config oxfmt.config.ts",
    "lint": "oxlint"
  },
  "dependencies": {
    "@forge/core": "workspace:*",
    "@forge/opencode": "workspace:*",
    "@optique/core": "^1.2.2",
    "@optique/discover": "^1.2.2",
    "execa": "^10.0.1",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "catalog:",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "1.78.0",
    "skills-npm": "^1.2.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.0"
}
